int parseOnOff(String v, bool current) {  // 1 on, 0 off, -1 unknown
  v.trim();
  v.toLowerCase();
  if (v == "toggle") return current ? 0 : 1;
  if (v == "on" || v == "1" || v == "true" || v == "open" || v == "yes" || v == "start" || v == "arm") return 1;
  if (v == "off" || v == "0" || v == "false" || v == "close" || v == "closed" || v == "shut" || v == "no" ||
      v == "stop" || v == "disarm")
    return 0;
  return -1;
}
bool isNumber(const String &v) {
  if (v.isEmpty()) return false;
  for (unsigned i = 0; i < v.length(); i++) if (!isDigit(v[i])) return false;
  return true;
}

