#if USE_SPEAKER && SPEAKER_TYPE == SPEAKER_DFPLAYER
void dfSend(uint8_t cmd, uint16_t param) {  // DFPlayer serial protocol
  uint8_t f[10] = {0x7E, 0xFF, 0x06, cmd, 0x00, (uint8_t)(param >> 8), (uint8_t)param, 0, 0, 0xEF};
  int16_t sum = 0;
  for (int i = 1; i < 7; i++) sum -= f[i];
  f[7] = (uint8_t)(sum >> 8);
  f[8] = (uint8_t)sum;
  Serial2.write(f, 10);
}
#endif

#if USE_SPEAKER && SPEAKER_TYPE == SPEAKER_TONE
// Tone speaker: every clip becomes a short tune. {Hz, ms}, Hz 0 = pause.
struct Note { uint16_t hz, ms; };
const Note TUNE_UP[]    = {{880, 90}, {0, 30}, {1320, 120}, {0, 0}};
const Note TUNE_DOWN[]  = {{1320, 90}, {0, 30}, {880, 120}, {0, 0}};
const Note TUNE_BEEP[]  = {{1200, 120}, {0, 0}};
const Note TUNE_BELL[]  = {{659, 450}, {523, 700}, {0, 0}};
const Note TUNE_HELLO[] = {{523, 120}, {659, 120}, {784, 120}, {1047, 260}, {0, 0}};
const Note TUNE_NIGHT[] = {{784, 200}, {659, 200}, {523, 200}, {392, 400}, {0, 0}};
const Note TUNE_PARTY[] = {{523, 90}, {659, 90}, {784, 90}, {1047, 90}, {784, 90}, {1047, 250}, {0, 0}};
const Note TUNE_STOP[]  = {{1800, 80}, {0, 60}, {1800, 80}, {0, 60}, {1800, 80}, {0, 60}, {1800, 80}, {0, 0}};
const Note TUNE_ALARM[] = {{900, 250}, {1400, 250}, {900, 250}, {1400, 250}, {900, 250}, {1400, 250}, {0, 0}};
const Note TUNE_WARN[]  = {{400, 300}, {0, 80}, {400, 300}, {0, 0}};
const Note *tune = nullptr;
int tuneIdx = 0;
unsigned long noteEndsAt = 0;

const Note *tuneFor(int t) {
  switch (t) {
    case T_DOORBELL: return TUNE_BELL;
    case T_ONLINE: case T_HELLO: case T_WELCOME: return TUNE_HELLO;
    case T_GOODNIGHT: return TUNE_NIGHT;
    case T_PARTY: return TUNE_PARTY;
    case T_STOP: return TUNE_STOP;
    case T_ALARM: return TUNE_ALARM;
    case T_HOTSPOT: case T_SECURITY_HOLD: case T_MOTION: return TUNE_WARN;
    case T_BEEP: case T_CAR_GATE: case T_CAR_PARKED: case T_GATE_STOPPED: return TUNE_BEEP;
    case T_GATE_CLOSING: case T_LIGHTS_OFF: case T_LIVING_OFF: case T_BEDROOM_OFF: case T_GARAGE_OFF:
    case T_OUTDOOR_OFF: case T_FAN_OFF: case T_STRIP_OFF: case T_SECURITY_OFF: case T_ALARM_OFF:
    case T_GATE_CLOSED: return TUNE_DOWN;
    default: return TUNE_UP;
  }
}
#endif

void say(int track, bool force = false) {
  if (track <= 0 || track >= T_COUNT) return;
  if (!force && (quiet || !SPK.announce)) return;
  if (alarmOn && track != T_ALARM && track != T_ALARM_OFF) return;  // the siren wins
  SPK.pending = track;
}

void speakerLoop() {
#if USE_SPEAKER
  unsigned long now = millis();
  // keep the siren going while the alarm is on
  static unsigned long nextSiren = 0;
  if (alarmOn && (long)(now - nextSiren) >= 0) { SPK.pending = T_ALARM; nextSiren = now + 5200; }
  if (!alarmOn) nextSiren = 0;

  #if SPEAKER_TYPE == SPEAKER_DFPLAYER
  if ((long)(now - SPK.readyAt) < 0 || (long)(now - SPK.nextSendAt) < 0) return;
  if (!SPK.volumeSent) { dfSend(0x06, SPK.volume); SPK.volumeSent = true; SPK.nextSendAt = now + 150; return; }
  if (SPK.pending) {
    dfSend(0x12, SPK.pending);  // play /mp3/000N.mp3
    SPK.pending = 0;
    SPK.nextSendAt = now + 150;
  }
  #else
  if (SPK.pending) {           // start a new tune
    tune = tuneFor(SPK.pending);
    SPK.pending = 0;
    tuneIdx = 0;
    noteEndsAt = now;
  }
  if (tune && (long)(now - noteEndsAt) >= 0) {
    const Note &n = tune[tuneIdx];
    if (n.ms == 0) { pwmTone(PIN_SPEAKER, CH_SPEAKER, 0); tune = nullptr; return; }
    pwmTone(PIN_SPEAKER, CH_SPEAKER, SPK.volume ? n.hz : 0);
    noteEndsAt = now + n.ms;
    tuneIdx++;
  }
  #endif
#endif
}

void setVolume(int v) {
  SPK.volume = constrain(v, 0, 30);
  SPK.volumeSent = false;
  logEvent("Speaker volume " + String(SPK.volume));
}

